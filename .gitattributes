# Verify rejects verified snapshots that contain CR in the working tree.
# Disable Git text/CRLF conversion so Windows core.autocrlf cannot rewrite them.
# Repository blobs already store LF; the working tree must match that exactly.
*.verified.txt -text

# Received files are generated by Verify and ignored by .gitignore (*.received.*).
# No repository checkout rule is required for them.
