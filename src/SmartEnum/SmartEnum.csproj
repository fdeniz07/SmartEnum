<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SmartEnum</RootNamespace>
    <AssemblyName>SmartEnum</AssemblyName>
    <PackageId>SmartEnum.Core</PackageId>
    <Description>Lightweight Smart Enum for .NET</Description>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The shipping package is produced by SmartEnum.Packaging.
    Core must not take a ProjectReference to SmartEnum.Generators.
  -->

</Project>
